{
  "manifest_version": 3,
  "name": "Astra native extension fixture",
  "version": "1.0.0",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["content.js"] }]
}
