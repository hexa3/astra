{
  "name": "astra-browser",
  "productName": "Astra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A quiet, open browser. Local by default. Yours by design.",
  "license": "MIT",
  "author": "Astra contributors",
  "homepage": "https://github.com/hexa3/astra",
  "repository": {
    "type": "git",
    "url": "https://github.com/hexa3/astra.git"
  },
  "desktopName": "astra-browser.desktop",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "vite build && node scripts/build.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "format:css": "prettier src/renderer/style.css --write",
    "start": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:native": "node scripts/test-native.mjs",
    "test:live": "node scripts/smoke-live.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:e2e && npm run test:native",
    "package:linux": "npm run build && electron-builder --linux AppImage deb",
    "package:dir": "npm run build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "tldts": "^7.0.0"
  },
  "devDependencies": {
    "@fontsource/doto": "^5.2.0",
    "@playwright/test": "^1.58.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "3.9.6",
    "svelte": "5.57.0",
    "svelte-check": "^4.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "org.astra.browser",
    "files": [
      "dist/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/ASTRA-MIT.txt"
      },
      {
        "from": "LICENSES",
        "to": "licenses"
      }
    ],
    "directories": {
      "output": "release"
    },
    "publish": null,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "Astra contributors",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
